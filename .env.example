# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME=AI Insider Threat Intelligence Platform
DEBUG=false

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=insider_threat_db

# ─── JWT Security ─────────────────────────────────────────────────────────────
# IMPORTANT: Change this in production! Use: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ─── ML Models ────────────────────────────────────────────────────────────────
ML_MODELS_PATH=./ml/saved_models
